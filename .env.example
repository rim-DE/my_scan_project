# Copie ce fichier en .env puis remplis les valeurs.

# ---------- Obligatoire ----------
# Base PostgreSQL (docker compose up -d en fournit une en local)
DATABASE_URL="postgresql://biblio:biblio@localhost:5432/biblio"
# Clé secrète pour signer les sessions : au moins 32 caractères aléatoires (openssl rand -base64 32)
AUTH_SECRET=""
# Clé API Claude (https://console.anthropic.com) : sert à repérer les livres sur les photos
ANTHROPIC_API_KEY=""

# ---------- Optionnel ----------
# Modèle Claude utilisé pour la vision
ANTHROPIC_MODEL="claude-opus-5-5"
# Clé Google Books (gratuite, recommandée : sans clé le quota partagé est vite épuisé)
GOOGLE_BOOKS_API_KEY=""

# Comptes : le tout premier compte peut toujours s'inscrire ; ensuite il faut ALLOW_REGISTRATION=true
ALLOW_REGISTRATION=false
# Crédits offerts à la création du compte, et coût d'une photo
INITIAL_CREDITS=100
CREDITS_PER_PHOTO=1

# Stockage des photos : "local" (dossier LOCAL_UPLOAD_DIR) ou "s3" (obligatoire sur Vercel)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=""
S3_REGION="auto"
# Laisser vide pour AWS ; renseigner pour Cloudflare R2, Scaleway, MinIO…
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Prix ----------
# Durée pendant laquelle un prix est réutilisé avant de rappeler la source (heures)
PRICE_CACHE_TTL_HOURS=24
# eBay Browse API (gratuite) : https://developer.ebay.com
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# Keepa (payant) pour les prix Amazon : https://keepa.com/#!api
KEEPA_API_KEY=""
# true = prix FAUX générés pour tester l'interface sans clé (affichés avec un avertissement)
PRICE_DEMO_MODE=false

# Paramètres de calcul de rentabilité
RESALE_FEE_RATE=0.15
RESALE_FIXED_COST_CENTS=150
TARGET_ROI=1

# Secret de la route /api/cron (Vercel Cron l'envoie automatiquement si tu le définis)
# Génère-le avec : openssl rand -base64 32
CRON_SECRET=""
